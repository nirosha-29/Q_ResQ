# Environment Variables for Q-ResQ

PORT=8000
ENVIRONMENT=development
DATABASE_URL=sqlite:///./q_resq.db
TIMEZONE=Asia/Kolkata
Q_RESQ_DEMO_PASSWORD=demo123
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# OSRM Public Routing URL (fallback to Haversine routing if unavailable)
OSRM_ROUTING_URL=https://router.project-osrm.org

# OpenStreetMap Overpass API (fallback to cached/demo facilities if unavailable)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Quantum Settings
QUANTUM_SIMULATOR_BACKEND=aer_simulator
QAOA_LAYERS=2
QAOA_SHOTS=1024
MAX_QUANTUM_QUBITS=16
QUANTUM_TIMEOUT_SECONDS=10.0
